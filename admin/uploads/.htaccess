# Deny execution of scripts in uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|inc|pl|py|cgi|sh|bash|exe|asp|aspx|jsp)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Prevent script handler execution
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
